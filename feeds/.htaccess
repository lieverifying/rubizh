Options -Indexes
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://rubizh.shop%{REQUEST_URI} [R=301,L]
RewriteRule ^google\.xml$ google.php [L]
RewriteRule ^meta\.csv$ meta.php [L]
<Files "feed.php">
 Require all denied
</Files>
