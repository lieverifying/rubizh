# Все запросы к /api/... обрабатывает index.php
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://rubizh.shop%{REQUEST_URI} [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
# Секреты и служебные файлы снаружи не читаются
<FilesMatch "^(config|lib|database|perf|http-download|photo-storage|schema|np-private|mono-private|seller|photo-status|pim-private)\.php$|\.sql$|\.log$">
  Require all denied
</FilesMatch>
# PIM шлёт ключ в заголовке Authorization — передаём его PHP
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

<FilesMatch "^site-settings\.(json|lock)$|^settings-">
  Require all denied
</FilesMatch>
